# ========================================
# CONFIGURAÇÃO DO CLOUDINARY AI
# ========================================

# 1. Crie uma conta GRATUITA no Cloudinary:
#    https://cloudinary.com/users/register/free

# 2. Após criar a conta, vá em Dashboard e copie:
VITE_CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
VITE_CLOUDINARY_API_KEY=sua_api_key_aqui
VITE_CLOUDINARY_API_SECRET=seu_api_secret_aqui

# ========================================
# PLANO GRATUITO DO CLOUDINARY:
# ========================================
# ✅ 25 GB de armazenamento
# ✅ 25 GB de bandwidth/mês
# ✅ 25.000 transformações/mês
# ✅ Upscaling com IA
# ✅ Auto enhancement
# ✅ Background removal (limitado)
# ✅ Otimização automática de formato/qualidade

# ========================================
# COMO CONFIGURAR:
# ========================================

# 1. Acesse: https://console.cloudinary.com/
# 2. Vá em Settings > Upload
# 3. Crie um Upload Preset:
#    - Nome: ml_default
#    - Signing Mode: Unsigned
#    - Folder: products
#    - Allowed formats: jpg, png, webp
#    - Max file size: 5 MB

# 4. Habilite AI Features:
#    - Settings > AI & Automation
#    - Enable: Auto Enhancement
#    - Enable: Upscaling
#    - Enable: Background Removal

# ========================================
# ALTERNATIVAS GRATUITAS:
# ========================================

# Replicate (Stable Diffusion Upscaler):
# VITE_REPLICATE_API_TOKEN=seu_token_aqui
# Custo: ~$0.002 por imagem

# Remove.bg (Background Removal):
# VITE_REMOVEBG_API_KEY=sua_key_aqui
# Plano grátis: 50 imagens/mês

